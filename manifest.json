{
  "manifest_version": 3,
  "name": "GCP JSON 自动生成与归档工具",
  "version": "3.3.0",
  "description": "在 Google Cloud Console 自动开启 Sheets/Drive API，一键生成低配服务账号或高级 OAuth 公开客户端 JSON 凭证，并安全归档至私密 Google 表格。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GCP JSON 自动生成与归档工具",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://console.cloud.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://console.cloud.google.com/*"],
      "js": ["page-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://console.cloud.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
